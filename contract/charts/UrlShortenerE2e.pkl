/// Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.
@A.Chart { title = "url-shortener-e2e chart values" }
module urlshortener.charts.UrlShortenerE2e

import "@vocab/Annotations.pkl" as A
import "@vocab/Check.pkl"
import "@vocab/Vocab.pkl" as V

/// The application release under test. Every install names its own.
@A.SetAtInstall
appRelease: V.NonEmptyString?

mode: "full" | "tenant" = "full"

rolloutTimeout: String = ""

database: Database

events: Events

archive: Archive

traces: Traces?

images: Images

pullPolicy: V.PullPolicy = "IfNotPresent"

job: Job

/// Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale.
resources: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }

serviceAccount: ServiceAccount?

podSecurity: PodSecurity?

prober: Prober?

tls: Tls?

otel: Otel?

class DatabaseOwner {
  /// The owner role. Every install names its own.
  @A.SetAtInstall
  role: V.NonEmptyString?
}

class DatabaseApp {
  /// The role the service connects as. Every install names its own.
  @A.SetAtInstall
  role: V.NonEmptyString?

  /// The Secret holding the role's password. Every install names its own.
  @A.SetAtInstall
  passwordSecret: V.NonEmptyString?

  passwordKey: V.NonEmptyString = "password"
}

class Database {
  /// The database host. Every install names its own.
  @A.SetAtInstall
  host: V.NonEmptyString?

  /// The database name. Every install names its own.
  @A.SetAtInstall
  name: V.NonEmptyString?

  owner: DatabaseOwner

  app: DatabaseApp
}

class Events {
  /// Every name below is given by the install, never derived.
  @A.SetAtInstall
  stream: V.NonEmptyString?

  @A.SetAtInstall
  redirectSubject: V.NonEmptyString?

  @A.SetAtInstall
  requestSubject: V.NonEmptyString?

  @A.SetAtInstall
  statConsumer: V.NonEmptyString?

  @A.SetAtInstall
  logConsumer: V.NonEmptyString?
}

class Archive {
  /// The bucket, which exists already. Every install names its own.
  @A.SetAtInstall
  bucket: V.NonEmptyString?

  region: String = ""

  endpoint: String = ""

  credentialsSecret: String = ""

  accessKeyIDKey: V.NonEmptyString = "accessKeyID"

  secretAccessKeyKey: V.NonEmptyString = "secretAccessKey"
}

class TracesTokenExchange {
  tokenURL: String = ""

  client: String = ""

  audience: V.NonEmptyString = "access-issuer"

  expirationSeconds: V.PositiveInt = 3600
}

class Traces {
  url: String = ""

  tokenExchange: TracesTokenExchange?

  caConfigMap: String = ""

  caConfigMapKey: V.NonEmptyString = "ca-certificates.crt"
}

class ImagesE2e {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/e2e"

  tag: String = ""

  digest: String = ""
}

class ImagesProber {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/prober"

  tag: String = ""

  digest: String = ""
}

class Images {
  e2e: ImagesE2e

  prober: ImagesProber?
}

/// The e2e Job's own switch for presenting a workload identity, on top of the release-wide tls block. Needs tls.mode (or a target's override) not off.
class JobTls {
  enabled: Boolean = false
}

class Job {
  /// OPTIONAL, and UNSET by default: a GitOps controller with self-heal on recreates a Job that deleted itself, so templates/job.yaml renders this key only when it is set. Absent or null skip it; a value must still clear the floor below.
  @A.Range { min = 120 }
  ttlSecondsAfterFinished: V.PositiveInt?

  backoffLimit: V.NonNegativeInt = 0

  activeDeadlineSeconds: V.PositiveInt = 300

  /// Rendered on the Job's own metadata, never the pod template's — for a GitOps controller that must replace, not patch, an immutable Job when this chart's values change at the same version, e.g. a force/replace sync option.
  annotations: Mapping<String, String> = new Mapping {}

  /// The e2e Job's own switch for presenting a workload identity, on top of the release-wide tls block. Needs tls.mode (or a target's override) not off.
  tls: JobTls?
}

class ServiceAccount {
  create: Boolean = true

  name: String = ""
}

class PodSecurity {
  runAsUser: V.NonNegativeInt = 65532

  runAsGroup: V.NonNegativeInt = 65532

  fsGroup: V.NonNegativeInt = 65532
}

class ProberLog {
  level: V.LogLevel = "info"
}

class ProberDrain {
  seconds: V.PositiveInt = 5
}

class Prober {
  enabled: Boolean = false

  interval: V.NonEmptyString = "10s"

  keyPrefix: V.NonEmptyString = "probe-"

  statSettle: V.GoDuration = "60s"

  pullPolicy: V.PullPolicy = "IfNotPresent"

  /// Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale.
  resources: V.OpenObject = new Dynamic { requests { cpu = "10m"; memory = "32Mi" } }

  log: ProberLog?

  drain: ProberDrain?

  podSecurity: PodSecurity?

  serviceAccount: ServiceAccount?
}

class TlsComponentsUrls {
  mode: V.TlsMode?
}

/// Never `strict`: the application chart runs redirect behind a gateway that terminates TLS.
class TlsComponentsRedirect {
  mode: V.GatewayTlsMode?
}

/// Per-target override of tls.mode: the mode the APPLICATION RELEASE runs `urls` and `redirect` in, which decides the port and scheme this chart's callers dial. Same meaning as charts/url-shortener's own tls.components. Unset means tls.mode.
class TlsComponents {
  urls: TlsComponentsUrls?

  /// Never `strict`: the application chart runs redirect behind a gateway that terminates TLS.
  redirect: TlsComponentsRedirect?
}

class TlsPeersItem {
  namespace: V.NonEmptyString

  serviceAccount: V.NonEmptyString
}

class Tls {
  mode: V.TlsMode = "off"

  /// Per-target override of tls.mode: the mode the APPLICATION RELEASE runs `urls` and `redirect` in, which decides the port and scheme this chart's callers dial. Same meaning as charts/url-shortener's own tls.components. Unset means tls.mode.
  components: TlsComponents?

  trustDomain: String = ""

  csiDriver: V.NonEmptyString = "spiffe.csi.cert-manager.io"

  mountPath: V.NonEmptyString = "/var/run/identity"

  grantRequest: Boolean = true

  port: V.Port = 8443

  peers: Listing<TlsPeersItem> = new Listing {}
}

class Otel {
  endpoint: String = ""

  protocol: V.OtelProtocol = "http/protobuf"

  tracesSampler: V.NonEmptyString = "parentbased_traceidratio"

  sampleRatio: V.NonEmptyString = "0.1"

  resourceAttributes: Mapping<String, String> = new Mapping {}
}

output {
  value = Check.checked(module)
}
