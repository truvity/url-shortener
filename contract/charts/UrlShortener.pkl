/// Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.
@A.Chart { title = "url-shortener chart values" }
@A.RequiredUnless {
  property = "alerts.remote.enabled"
  `in` { true }
  require {
    "database.host"
    "database.app.passwordSecret"
    "events.url"
    "archive.bucket.name"
  }
}
module urlshortener.charts.UrlShortener

import "@fragments/Fragments.pkl" as F
import "@vocab/Annotations.pkl" as A
import "@vocab/Check.pkl"
import "@vocab/Vocab.pkl" as V

import "Tier.pkl"

/// Not a value: Helm puts a key named for every sub-chart into the values it validates, and the library chart this chart renders its components with is one. It takes no values of its own; each component's `platform` and `config` are built in templates/_components.tpl.
`service-lib`: F.ServiceLib?

/// The name this install is known by, folded into the NATS subject and durable consumer names. Empty means this chart's own release name. Letters, digits and hyphens only, at most 40 characters.
installName: String = ""

/// Which kind of install this is, as url-shortener-infra's `tier`. `primary`: the identity ServiceAccount is rendered by url-shortener-infra, not here. `test`: this chart renders every account.
tier: Tier.Tier = "test"

/// How much redundancy this cluster wants (delivery interface step 14). `single`: one replica of every component and no PodDisruptionBudget. `high`: two replicas and a budget that keeps one running. Absent means `single`.
availability: "single" | "high" = "single"

/// Product alerts as a VMRule. Off by default; `remote` renders only the rule object, for an install evaluated on another cluster (no other value is then required).
alerts: Alerts?

database: Database

events: Events

/// Where the request archive goes. The vendor is not in here: an endpoint, a region and a path-style flag reach a cloud service, a store inside the cluster or a test double.
archive: Archive

log: Log

/// An explicit replica count for one component, which wins over `availability`.
replicas: Replicas

/// Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale.
resources: Resources

route: Route

serviceAccount: ServiceAccount?

/// The front end's own settings.
web: Web?

drain: Drain?

disruption: Disruption?

tls: Tls?

podSecurity: PodSecurity?

/// An always-on synthetic prober against this release's urls and redirect Services. Off by default. It follows this release's tls and otel, and takes no Kubernetes API access.
prober: Prober

images: Images

pullPolicy: V.PullPolicy = "IfNotPresent"

otel: Otel?

class AlertsRemote {
  enabled: Boolean = false

  clusterName: V.DnsLabel?

  namespace: V.DnsLabel?
}

class AlertsProber {
  namespace: V.DnsLabel?
}

class AlertsJourneyFailing {
  enabled: Boolean = true

  `for`: V.PromDuration = "10m"

  @A.Range { exclusiveMin = 0; max = 1 }
  ratio: Number = 0.5

  window: V.PromDuration = "15m"
}

class AlertsProberAbsent {
  enabled: Boolean = true

  `for`: V.PromDuration = "15m"
}

class AlertsUrlsRpcLatency {
  enabled: Boolean = true

  `for`: V.PromDuration = "15m"

  @A.Range { exclusiveMin = 0 }
  seconds: Number = 1
}

class AlertsUrlsRpcErrors {
  enabled: Boolean = true

  `for`: V.PromDuration = "10m"

  @A.Range { exclusiveMin = 0; max = 1 }
  ratio: Number = 0.05

  @A.Range { min = 0 }
  minCallsPerSecond: Number = 0.05

  codes: V.StatusCodeList = "INTERNAL|UNKNOWN|UNAVAILABLE|DATA_LOSS|DEADLINE_EXCEEDED"
}

class AlertsHttp5xx {
  enabled: Boolean = true

  `for`: V.PromDuration = "10m"

  @A.Range { exclusiveMin = 0; max = 1 }
  ratio: Number = 0.05

  @A.Range { min = 0 }
  minRequestsPerSecond: Number = 0.05
}

class AlertsRedirectLatency {
  enabled: Boolean = true

  `for`: V.PromDuration = "15m"

  @A.Range { exclusiveMin = 0 }
  seconds: Number = 0.5
}

class AlertsWebLatency {
  enabled: Boolean = true

  `for`: V.PromDuration = "15m"

  @A.Range { exclusiveMin = 0 }
  seconds: Number = 2
}

/// Product alerts as a VMRule. Off by default; `remote` renders only the rule object, for an install evaluated on another cluster (no other value is then required).
class Alerts {
  enabled: Boolean = false

  ruleLabels: Mapping<String, String> = new Mapping {}

  @A.DenyKeys { keys { "severity"; "k8s_cluster_name" } }
  alertLabels: Mapping<String, V.NonEmptyString> = new Mapping {}

  interval: V.PromDuration?

  remote: AlertsRemote?

  prober: AlertsProber?

  journeyFailing: AlertsJourneyFailing?

  proberAbsent: AlertsProberAbsent?

  urlsRpcLatency: AlertsUrlsRpcLatency?

  urlsRpcErrors: AlertsUrlsRpcErrors?

  redirectHttp5xx: AlertsHttp5xx?

  webHttp5xx: AlertsHttp5xx?

  redirectLatency: AlertsRedirectLatency?

  webLatency: AlertsWebLatency?
}

class DatabaseTlsRootCA {
  /// The ConfigMap holding the root the database server certificate chains to. Required.
  configMapName: String = ""

  key: V.NonEmptyString = "ca-certificates.crt"
}

class DatabaseTls {
  /// Only verify-full: the database client verifies the server against the root below, or does not connect. Kept so a platform that already sets it keeps rendering; `require` is refused.
  mode: "verify-full" = "verify-full"

  rootCA: DatabaseTlsRootCA?
}

/// The owner's credential, for the schema migration Job alone (delivery interface step 15). No long-running workload gets it.
class DatabaseMigration {
  role: V.NonEmptyString = "url_shortener_owner"

  /// The Secret holding the role's password. Every install names its own.
  passwordSecret: V.NonEmptyString?

  passwordKey: V.NonEmptyString = "password"
}

/// Deprecated spelling of `migration`, read only when `migration` leaves the key unset.
class DatabaseOwner {
  role: V.NonEmptyString?

  passwordSecret: V.NonEmptyString?

  passwordKey: V.NonEmptyString?
}

class DatabaseApp {
  role: V.NonEmptyString = "url_shortener_app"

  /// The Secret holding the role's password. Every install names its own.
  passwordSecret: V.NonEmptyString?

  passwordKey: V.NonEmptyString = "password"
}

class Database {
  /// The database host. Every install names its own.
  host: V.NonEmptyString?

  name: V.NonEmptyString = "url_shortener"

  clusterDomain: V.NonEmptyString = "cluster.local"

  tls: DatabaseTls?

  /// The owner's credential, for the schema migration Job alone (delivery interface step 15). No long-running workload gets it.
  migration: DatabaseMigration?

  /// Deprecated spelling of `migration`, read only when `migration` leaves the key unset.
  owner: DatabaseOwner?

  app: DatabaseApp
}

class EventsAuth {
  audience: String = ""

  @A.Range { min = 600 }
  expirationSeconds: V.PositiveInt = 3600
}

class EventsTls {
  enabled: Boolean = false

  serverName: String = ""

  caConfigMap: String = ""

  caKey: V.NonEmptyString = "ca-certificates.crt"
}

class Events {
  /// The events server's URL. Every install names its own.
  url: V.NonEmptyString?

  auth: EventsAuth?

  tls: EventsTls?
}

class ArchiveBucket {
  /// The bucket, which exists already. Every install names its own.
  name: V.NonEmptyString?

  region: String = ""

  endpoint: String = ""

  ca: String = ""

  pathStyle: Boolean = false

  /// The Secret holding static credentials. Empty means the SDK's ambient credentials, which is what a workload identity provides.
  credentialsSecret: String = ""

  accessKeyIDKey: V.NonEmptyString = "accessKeyID"

  secretAccessKeyKey: V.NonEmptyString = "secretAccessKey"
}

class ArchiveBatch {
  maxRecords: V.PositiveInt = 500

  maxSeconds: V.PositiveInt = 60
}

/// Where the request archive goes. The vendor is not in here: an endpoint, a region and a path-style flag reach a cloud service, a store inside the cluster or a test double.
class Archive {
  bucket: ArchiveBucket

  prefix: V.NonEmptyString = "url-shortener/requests"

  batch: ArchiveBatch?
}

class Log {
  level: V.LogLevel = "info"
}

class Replicas {
  redirect: V.NonNegativeInt?

  stat: V.NonNegativeInt?

  log: V.NonNegativeInt?

  urls: V.NonNegativeInt?

  web: V.NonNegativeInt?
}

/// Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale.
class Resources {
  redirect: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }

  stat: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }

  migrate: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }

  log: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "128Mi" } }

  urls: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }

  web: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "96Mi" } }

  verify: V.OpenObject = new Dynamic { requests { cpu = "50m"; memory = "64Mi" } }
}

class RouteParentRef {
  name: String = ""

  namespace: String = ""

  sectionName: String = ""

  group: String = ""

  kind: String = ""
}

class RouteFaroBackend {
  name: String = ""

  namespace: String = ""

  @A.Range { max = 65535 }
  port: V.NonNegativeInt = 0
}

/// An optional PUBLIC rule that routes the page's telemetry path to a collector Service. Off by default.
class RouteFaro {
  enabled: Boolean = false

  ruleName: V.NonEmptyString = "faro"

  path: V.UrlPath = "/faro/collect"

  rewritePath: V.UrlPathOrEmpty = ""

  /// The largest request body the gateway accepts on the telemetry rule, as a quantity such as 256Ki. Absent renders no policy.
  requestBufferLimit: V.BufferLimit?

  backend: RouteFaroBackend?
}

class Route {
  enabled: Boolean = false

  hostname: String = ""

  parentRef: RouteParentRef?

  ruleName: V.NonEmptyString = "app"

  /// An optional PUBLIC rule that routes the page's telemetry path to a collector Service. Off by default.
  faro: RouteFaro?

  /// The rule that resolves short links. Separate from ruleName so a policy can protect the site without locking the public resolver.
  redirectRuleName: V.NonEmptyString = "redirect"
}

class ServiceAccountApp {
  name: String = ""

  annotations: Mapping<String, String> = new Mapping {}
}

/// One component's account override.
class ServiceAccountOverride {
  @A.Length { max = 253 }
  name: V.DnsName?

  annotations: Mapping<String, String>?
}

/// Per-component account overrides. Every component always runs as its own account.
class ServiceAccountComponents {
  redirect: ServiceAccountOverride?

  urls: ServiceAccountOverride?

  web: ServiceAccountOverride?

  stat: ServiceAccountOverride?

  log: ServiceAccountOverride?
}

class ServiceAccount {
  create: Boolean = true

  app: ServiceAccountApp?

  migrate: ServiceAccountApp?

  /// Per-component account overrides. Every component always runs as its own account.
  components: ServiceAccountComponents?
}

class WebCsp {
  mode: V.CspMode = "report-only"

  connectSrc: Listing<V.HttpOrigin> = new Listing {}

  reportUri: V.ReportUri = ""
}

/// Browser telemetry. Public by design: every value is shipped to every visitor, so no secret belongs here.
class WebFaro {
  enabled: Boolean = false

  collectorUrl: V.CollectorUrl = "/faro/collect"

  apiKey: V.PublicKey = ""

  appName: String = "url-shortener-web"

  environment: String = ""

  sampleRate: V.Ratio = 1
}

/// The front end's own settings.
class Web {
  csp: WebCsp?

  /// Browser telemetry. Public by design: every value is shipped to every visitor, so no secret belongs here.
  faro: WebFaro?
}

class Drain {
  seconds: V.PositiveInt = 20

  preStopSeconds: V.NonNegativeInt = 5
}

class Disruption {
  /// Absent follows `availability`: a budget renders for `high` only.
  enabled: Boolean?

  maxUnavailable: V.NonNegativeInt = 1
}

class TlsComponentsUrls {
  mode: V.TlsMode?
}

/// Never `strict`: the redirect service is fronted by a gateway that terminates TLS and forwards cleartext.
class TlsComponentsRedirect {
  mode: V.GatewayTlsMode?
}

/// Per-component override of tls.mode, for the two components that SERVE an authenticated boundary. `web` and `stat` only call out and have no mode of their own. Unset means tls.mode.
class TlsComponents {
  urls: TlsComponentsUrls?

  /// Never `strict`: the redirect service is fronted by a gateway that terminates TLS and forwards cleartext.
  redirect: TlsComponentsRedirect?
}

class TlsPeersRedirectItem {
  namespace: V.NonEmptyString

  serviceAccount: V.NonEmptyString
}

class TlsPeers {
  redirect: Listing<TlsPeersRedirectItem> = new Listing {}

  urls: Listing<TlsPeersRedirectItem> = new Listing {}
}

class Tls {
  /// The release-wide default for the components that serve an authenticated boundary. `strict` is accepted here only where `redirect` is overridden below: redirect is gateway-fronted and can never be strict, so the render refuses it when inherited. To make only the URL service strict, set `permissive` (or `off`) here and `tls.components.urls.mode: strict`.
  mode: V.TlsMode = "off"

  /// Per-component override of tls.mode, for the two components that SERVE an authenticated boundary. `web` and `stat` only call out and have no mode of their own. Unset means tls.mode.
  components: TlsComponents?

  trustDomain: String = ""

  csiDriver: V.NonEmptyString = "spiffe.csi.cert-manager.io"

  mountPath: V.NonEmptyString = "/var/run/identity"

  grantRequest: Boolean = true

  port: V.Port = 8443

  peers: TlsPeers?
}

class PodSecurity {
  runAsUser: V.NonNegativeInt = 65532

  runAsGroup: V.NonNegativeInt = 65532

  fsGroup: V.NonNegativeInt = 65532
}

class ImagesMigrate {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/migrate"

  tag: String = ""

  digest: String = ""
}

class ImagesRedirect {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/redirect"

  tag: String = ""

  digest: String = ""
}

class ImagesUrls {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/urls"

  tag: String = ""

  digest: String = ""
}

class ImagesStat {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/stat"

  tag: String = ""

  digest: String = ""
}

class ImagesLog {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/log"

  tag: String = ""

  digest: String = ""
}

class ImagesWeb {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/web"

  tag: String = ""

  digest: String = ""
}

class ImagesProber {
  registry: V.NonEmptyString = "ghcr.io"

  repository: V.NonEmptyString = "truvity/policy/url-shortener/prober"

  tag: String = ""

  digest: String = ""
}

class Images {
  migrate: ImagesMigrate

  redirect: ImagesRedirect

  urls: ImagesUrls

  stat: ImagesStat

  log: ImagesLog

  web: ImagesWeb

  prober: ImagesProber
}

class ProberLog {
  level: V.LogLevel = "info"
}

class ProberDrain {
  seconds: V.PositiveInt = 5
}

class ProberServiceAccount {
  create: Boolean = true

  name: String = ""
}

/// An always-on synthetic prober against this release's urls and redirect Services. Off by default. It follows this release's tls and otel, and takes no Kubernetes API access.
class Prober {
  enabled: Boolean = false

  interval: V.NonEmptyString = "10s"

  keyPrefix: V.NonEmptyString = "probe-"

  statSettle: String = "60s"

  /// Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale.
  resources: V.OpenObject = new Dynamic { requests { cpu = "10m"; memory = "32Mi" } }

  log: ProberLog?

  drain: ProberDrain?

  serviceAccount: ProberServiceAccount?
}

class Otel {
  endpoint: String = ""

  protocol: V.OtelProtocol = "http/protobuf"

  tracesSampler: V.NonEmptyString = "parentbased_traceidratio"

  sampleRatio: V.NonEmptyString = "0.1"

  resourceAttributes: Mapping<String, String> = new Mapping {}
}

output {
  value = Check.checked(module)
}
