{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener chart values",
  "description": "Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database",
    "events",
    "archive",
    "log",
    "replicas",
    "resources",
    "route",
    "images"
  ],
  "properties": {
    "service-lib": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object",
          "description": "Helm's own `global` block, passed through unchanged."
        }
      },
      "description": "Not a value: Helm puts a key named for every sub-chart into the values it validates, and the library chart this chart renders its components with is one. It takes no values of its own; each component's `platform` and `config` are built in templates/_components.tpl."
    },
    "installName": {
      "type": "string",
      "description": "The name this install is known by, folded into the NATS subject and durable consumer names. Empty means this chart's own release name. Letters, digits and hyphens only, at most 40 characters.",
      "default": ""
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "app"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "The database host. Every install names its own."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "default": "url_shortener"
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1,
          "default": "cluster.local"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "verify-full"
              ],
              "description": "Only verify-full: the database client verifies the server against the root below, or does not connect. Kept so a platform that already sets it keeps rendering; `require` is refused.",
              "default": "verify-full"
            },
            "rootCA": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMapName": {
                  "type": "string",
                  "description": "The ConfigMap holding the root the database server certificate chains to. Required.",
                  "default": ""
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "default": "ca-certificates.crt"
                }
              }
            }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "default": "url_shortener_owner"
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret holding the role's password. Every install names its own."
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1,
              "default": "password"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "default": "url_shortener_app"
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret holding the role's password. Every install names its own."
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1,
              "default": "password"
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "The events server's URL. Every install names its own."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string",
              "default": ""
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 600,
              "default": 3600
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "serverName": {
              "type": "string",
              "default": ""
            },
            "caConfigMap": {
              "type": "string",
              "default": ""
            },
            "caKey": {
              "type": "string",
              "minLength": 1,
              "default": "ca-certificates.crt"
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "The bucket, which exists already. Every install names its own."
            },
            "region": {
              "type": "string",
              "default": ""
            },
            "endpoint": {
              "type": "string",
              "default": ""
            },
            "ca": {
              "type": "string",
              "default": ""
            },
            "pathStyle": {
              "type": "boolean",
              "default": false
            },
            "credentialsSecret": {
              "type": "string",
              "description": "The Secret holding static credentials. Empty means the SDK's ambient credentials, which is what a workload identity provides.",
              "default": ""
            },
            "accessKeyIDKey": {
              "type": "string",
              "minLength": 1,
              "default": "accessKeyID"
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1,
              "default": "secretAccessKey"
            }
          }
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "default": "url-shortener/requests"
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRecords": {
              "type": "integer",
              "minimum": 1,
              "default": 500
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            }
          }
        }
      },
      "description": "Where the request archive goes. The vendor is not in here: an endpoint, a region and a path-style flag reach a cloud service, a store inside the cluster or a test double."
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redirect": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "stat": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "log": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "urls": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "web": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redirect": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          }
        },
        "stat": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          }
        },
        "migrate": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          }
        },
        "log": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "128Mi"
            }
          }
        },
        "urls": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          }
        },
        "web": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "96Mi"
            }
          }
        },
        "verify": {
          "type": "object",
          "default": {
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          }
        }
      },
      "description": "Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale."
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hostname": {
          "type": "string",
          "default": ""
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "default": ""
            },
            "namespace": {
              "type": "string",
              "default": ""
            },
            "sectionName": {
              "type": "string",
              "default": ""
            },
            "group": {
              "type": "string",
              "default": ""
            },
            "kind": {
              "type": "string",
              "default": ""
            }
          }
        },
        "ruleName": {
          "type": "string",
          "minLength": 1,
          "default": "app"
        },
        "faro": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "ruleName": {
              "type": "string",
              "minLength": 1,
              "default": "faro"
            },
            "path": {
              "type": "string",
              "pattern": "^/[^\\t \\xA0  -   　'\"<>;,?#]*$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "default": "/faro/collect"
            },
            "rewritePath": {
              "type": "string",
              "pattern": "^(/[^\\t \\xA0  -   　'\"<>;,?#]*)?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "default": ""
            },
            "requestBufferLimit": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|k|M|G)?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "description": "The largest request body the gateway accepts on the telemetry rule, as a quantity such as 256Ki. Absent renders no policy."
            },
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "default": ""
                },
                "namespace": {
                  "type": "string",
                  "default": ""
                },
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535,
                  "default": 0
                }
              }
            }
          },
          "description": "An optional PUBLIC rule that routes the page's telemetry path to a collector Service. Off by default."
        },
        "redirectRuleName": {
          "type": "string",
          "minLength": 1,
          "description": "The rule that resolves short links. Separate from ruleName so a policy can protect the site without locking the public resolver.",
          "default": "redirect"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "default": ""
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          }
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "default": ""
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redirect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "urls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "web": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "stat": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "log": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "Per-component account overrides. Every component always runs as its own account."
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "off",
                "report-only",
                "enforce"
              ],
              "default": "report-only"
            },
            "connectSrc": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https?://[A-Za-z0-9.*-]+(:[0-9]+)?$",
                "not": {
                  "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                }
              },
              "default": []
            },
            "reportUri": {
              "type": "string",
              "pattern": "^[^\\t \\xA0  -   　;,'\"]*$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "default": ""
            }
          }
        },
        "faro": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "collectorUrl": {
              "type": "string",
              "pattern": "^(https://[^\\t \\xA0  -   　'\"<>;,]+|/[^\\t \\xA0  -   　'\"<>;,?#]*)$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "default": "/faro/collect"
            },
            "apiKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]*$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              },
              "default": ""
            },
            "appName": {
              "type": "string",
              "default": "url-shortener-web"
            },
            "environment": {
              "type": "string",
              "default": ""
            },
            "sampleRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            }
          },
          "description": "Browser telemetry. Public by design: every value is shipped to every visitor, so no secret belongs here."
        }
      },
      "description": "The front end's own settings."
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "preStopSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        }
      }
    },
    "disruption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "off",
            "permissive",
            "strict"
          ],
          "description": "The release-wide default for the components that serve an authenticated boundary. `strict` is accepted here only where `redirect` is overridden below: redirect is gateway-fronted and can never be strict, so the render refuses it when inherited. To make only the URL service strict, set `permissive` (or `off`) here and `tls.components.urls.mode: strict`.",
          "default": "off"
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive",
                    "strict"
                  ]
                }
              }
            },
            "redirect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive"
                  ]
                }
              },
              "description": "Never `strict`: the redirect service is fronted by a gateway that terminates TLS and forwards cleartext."
            }
          },
          "description": "Per-component override of tls.mode, for the two components that SERVE an authenticated boundary. `web` and `stat` only call out and have no mode of their own. Unset means tls.mode."
        },
        "trustDomain": {
          "type": "string",
          "default": ""
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1,
          "default": "spiffe.csi.cert-manager.io"
        },
        "mountPath": {
          "type": "string",
          "minLength": 1,
          "default": "/var/run/identity"
        },
        "grantRequest": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8443
        },
        "peers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redirect": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "default": []
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "default": []
            }
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0,
          "default": 65532
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0,
          "default": 65532
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0,
          "default": 65532
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrate",
        "redirect",
        "urls",
        "stat",
        "log",
        "web"
      ],
      "properties": {
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1,
              "default": "ghcr.io"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "default": "truvity/policy/url-shortener/migrate"
            },
            "tag": {
              "type": "string",
              "default": ""
            },
            "digest": {
              "type": "string",
              "default": ""
            }
          }
        },
        "redirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1,
              "default": "ghcr.io"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "default": "truvity/policy/url-shortener/redirect"
            },
            "tag": {
              "type": "string",
              "default": ""
            },
            "digest": {
              "type": "string",
              "default": ""
            }
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1,
              "default": "ghcr.io"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "default": "truvity/policy/url-shortener/urls"
            },
            "tag": {
              "type": "string",
              "default": ""
            },
            "digest": {
              "type": "string",
              "default": ""
            }
          }
        },
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
