{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener-infra chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postgres",
    "events"
  ],
  "properties": {
    "installName": {
      "type": "string",
      "description": "The name this install is known by, folded into the JetStream stream and subject names. Empty means this chart's own release name. Letters, digits and hyphens only, at most 40 characters.",
      "default": ""
    },
    "tier": {
      "enum": [
        "test",
        "primary"
      ],
      "description": "Which kind of install this is. `test` provisions nothing of its own; `primary` provisions the objects this install owns.",
      "default": "test"
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "default": ""
        },
        "iamName": {
          "type": "string",
          "default": ""
        },
        "clusterName": {
          "type": "string",
          "default": ""
        },
        "accountID": {
          "type": "string",
          "default": ""
        },
        "region": {
          "type": "string",
          "default": ""
        },
        "serviceAccount": {
          "type": "string",
          "default": ""
        },
        "permissionsBoundary": {
          "type": "string",
          "default": ""
        },
        "project": {
          "type": "string",
          "description": "The project this install belongs to, tagged as `project` beside `cluster` on every AWS resource this chart creates. Empty means this release's own namespace — the platforms this chart targets already treat a namespace as a project.",
          "default": ""
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra tags folded into every AWS resource this chart creates, beside `cluster` and `project`. Neither of those two can be overridden from here.",
          "default": {}
        }
      },
      "description": "The objects a primary install owns. Every name is given, never derived. Unused on a test install."
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1,
          "default": "1Gi"
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "default": "url_shortener"
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1,
          "default": "url_shortener_owner"
        },
        "runtimeRole": {
          "type": "string",
          "minLength": 1,
          "default": "url_shortener_app"
        },
        "runtimePasswordSecret": {
          "type": "string",
          "default": ""
        },
        "tenantScopedNames": {
          "type": "boolean",
          "description": "Off by default, so every existing consumer keeps the fixed database and role names byte-for-byte. When true, `database`, `ownerRole` and `runtimeRole` are derived from this install's tenant scope instead, for whichever of the three a caller left at its own chart default; an explicit value always wins regardless of this flag.",
          "default": false
        },
        "runtimePassword": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generate": {
              "type": "boolean",
              "default": false
            },
            "length": {
              "type": "integer",
              "default": 32
            }
          },
          "description": "Have the chart mint the runtime role's password via the ExternalSecrets Password generator, instead of taking the name of a secret someone else made."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "platformOwned": {
          "type": "boolean",
          "default": false
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "default": []
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objectStoreName": {
              "type": "string",
              "default": ""
            },
            "serverName": {
              "type": "string",
              "default": ""
            }
          }
        },
        "serverTLS": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "default": ""
            },
            "caSecretName": {
              "type": "string",
              "default": ""
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "enum": [
            "memory",
            "file"
          ],
          "default": "memory"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "default": "nats://nats.nats.svc:4222"
        },
        "account": {
          "type": "string",
          "default": ""
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "maxAge": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "$defs": {}
}
