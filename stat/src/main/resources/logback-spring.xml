<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON, to stderr, at one level.

  stderr rather than stdout because stdout is the program's product and
  stderr is its commentary. This program's product is rows in somebody
  else's table, so it writes nothing to stdout at all — which the framework
  does not do by default, and is the one thing this file is here to change.

  The structured format is the framework's own, so there is no encoder
  dependency to keep in step with it.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
        </encoder>
    </appender>

    <!--
      Wraps STDERR, not a config for it: before an event reaches the
      encoder above, this injects trace_id/span_id/trace_flags -- the
      current span's, in the W3C lower-case hex form -- into the MDC, and
      leaves them out entirely when no span is current. The ECS encoder
      already folds every MDC entry into the JSON object as a top-level
      field, so nothing here maps a field name: that would be a second
      place for the two encoders to agree.
    -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="STDERR"/>
    </appender>

    <root level="${LOG_LEVEL:-info}">
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
