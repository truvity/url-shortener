<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only wiring for LogTraceCorrelationTest.

  It is the same appender class the service's own logback-spring.xml wraps
  its STDERR appender with, wrapping a ListAppender instead: a test reads
  the MDC map directly this way, rather than parsing JSON back out of a
  stream to prove the same thing.
-->
<configuration>
    <appender name="LIST" class="ch.qos.logback.core.read.ListAppender"/>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="LIST"/>
    </appender>

    <logger name="correlation-test" level="INFO" additivity="false">
        <appender-ref ref="OTEL"/>
    </logger>
</configuration>
