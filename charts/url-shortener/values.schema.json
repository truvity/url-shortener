      "type": "object",
      "additionalProperties": false,
      "description": "An always-on synthetic prober against this release's urls and redirect Services. Off by default. It follows this release's tls and otel, and takes no Kubernetes API access.",
      "required": [
        "enabled",
        "interval",
        "keyPrefix"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "keyPrefix": {
          "type": "string",
          "minLength": 1
        },
        "statSettle": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"
        },
        "resources": {
          "type": "object",
          "description": "Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale."
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
