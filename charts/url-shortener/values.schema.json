{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener chart values",
  "description": "Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.",
  "type": "object",
  "additionalProperties": false,
  "if": {
    "required": ["alerts"],
    "properties": {
      "alerts": {
        "required": ["remote"],
        "properties": {
          "remote": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          }
        }
      }
    }
  },
  "else": {
    "$comment": "What a render of the workloads must be given: the values only an install can give, which values.yaml does not ship (each is also non-empty wherever it is set). Not required of a render of the alert rules alone (alerts.remote.enabled), which has no use for them.",
    "properties": {
      "database": {
        "required": ["host"],
        "properties": {
          "app": { "required": ["passwordSecret"] }
        }
      },
      "events": { "required": ["url"] },
      "archive": { "properties": { "bucket": { "required": ["name"] } } }
    },
    "required": [
      "database",
      "events",
      "log",
      "replicas",
      "resources",
      "route",
      "archive",
      "images"
    ]
  },
  "properties": {
    "service-lib": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object"
        }
      },
      "description": "Not a value: Helm puts a key named for every sub-chart into the values it validates, and the library chart this chart renders its components with is one. It takes no values of its own; each component's `platform` and `config` are built in templates/_components.tpl."
    },
    "installName": {
      "type": "string",
      "description": "The name this install is known by, folded into the NATS subject and durable consumer names. Empty means this chart's own release name. Letters, digits and hyphens only, at most 40 characters."
    },
    "tier": {
      "type": "string",
      "enum": [
        "test",
        "primary"
      ],
      "description": "Which kind of install this is, as url-shortener-infra's `tier`. `primary`: the identity ServiceAccount is rendered by url-shortener-infra, not here. `test`: this chart renders every account."
    },
    "availability": {
      "type": "string",
      "enum": [
        "single",
        "high"
      ],
      "description": "How much redundancy this cluster wants (delivery interface step 14). `single`: one replica of every component and no PodDisruptionBudget. `high`: two replicas and a budget that keeps one running. Absent means `single`."
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Product alerts as a VMRule. Off by default; `remote` renders only the rule object, for an install evaluated on another cluster (no other value is then required).",
      "properties": {
        "enabled": { "type": "boolean" },
        "ruleLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "alertLabels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "propertyNames": { "not": { "enum": ["severity", "k8s_cluster_name"] } }
        },
        "interval": { "type": "string", "pattern": "^([0-9]+(s|m|h))?$" },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterName": { "type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*)?$" },
            "namespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" }
          }
        },
        "prober": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "namespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" } }
        },
        "journeyFailing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "window": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
          }
        },
        "proberAbsent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
          }
        },
        "urlsRpcLatency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "urlsRpcErrors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "minCallsPerSecond": { "type": "number", "minimum": 0 },
            "codes": { "type": "string", "pattern": "^[A-Z_]+(\\|[A-Z_]+)*$" }
          }
        },
        "redirectHttp5xx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "minRequestsPerSecond": { "type": "number", "minimum": 0 }
          }
        },
        "webHttp5xx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "minRequestsPerSecond": { "type": "number", "minimum": 0 }
          }
        },
        "redirectLatency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "webLatency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
            "seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "app"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "The database host. Every install names its own."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "description": "Only verify-full: the database client verifies the server against the root below, or does not connect. Kept so a platform that already sets it keeps rendering; `require` is refused.",
              "enum": [
                "verify-full"
              ]
            },
            "rootCA": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMapName": {
                  "type": "string",
                  "description": "The ConfigMap holding the root the database server certificate chains to. Required."
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "description": "The owner's credential, for the schema migration Job alone (delivery interface step 15). No long-running workload gets it.",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret holding the role's password. Every install names its own."
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "description": "Deprecated spelling of `migration`, read only when `migration` leaves the key unset.",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret holding the role's password. Every install names its own."
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret holding the role's password. Every install names its own."
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "The events server's URL. Every install names its own."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string"
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 600
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverName": {
              "type": "string"
            },
            "caConfigMap": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the request archive goes. The vendor is not in here: an endpoint, a region and a path-style flag reach a cloud service, a store inside the cluster or a test double.",
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "The bucket, which exists already. Every install names its own."
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "ca": {
              "type": "string"
            },
            "pathStyle": {
              "type": "boolean"
            },
            "credentialsSecret": {
              "type": "string",
              "description": "The Secret holding static credentials. Empty means the SDK's ambient credentials, which is what a workload identity provides."
            },
            "accessKeyIDKey": {
              "type": "string",
              "minLength": 1
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRecords": {
              "type": "integer",
              "minimum": 1
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redirect": {
          "type": "integer",
          "minimum": 0
        },
        "stat": {
          "type": "integer",
          "minimum": 0
        },
        "log": {
          "type": "integer",
          "minimum": 0
        },
        "urls": {
          "type": "integer",
          "minimum": 0
        },
        "web": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jvmOptions": {
      "type": "object",
      "additionalProperties": false,
      "description": "JAVA_TOOL_OPTIONS of a component that runs on the JVM. Empty or left out sets nothing.",
      "properties": {
        "stat": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale.",
      "properties": {
        "redirect": {
          "type": "object"
        },
        "stat": {
          "type": "object"
        },
        "migrate": {
          "type": "object"
        },
        "log": {
          "type": "object"
        },
        "urls": {
          "type": "object"
        },
        "web": {
          "type": "object"
        },
        "verify": {
          "type": "object"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            },
            "group": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          }
        },
        "ruleName": {
          "type": "string",
          "minLength": 1
        },
        "faro": {
          "type": "object",
          "additionalProperties": false,
          "description": "An optional PUBLIC rule that routes the page's telemetry path to a collector Service. Off by default.",
          "properties": {
            "enabled": { "type": "boolean" },
            "ruleName": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^/[^\\s'\"<>;,?#]*$" },
            "rewritePath": { "type": "string", "pattern": "^(/[^\\s'\"<>;,?#]*)?$" },
            "requestBufferLimit": { "type": "string", "pattern": "^([0-9]+(Ki|Mi|Gi|k|M|G)?)?$", "description": "The largest request body the gateway accepts on the telemetry rule, as a quantity such as 256Ki. Absent, or empty, renders no policy." },
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": "string" },
                "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
              }
            }
          }
        },
        "redirectRuleName": {
          "type": "string",
          "minLength": 1,
          "description": "The rule that resolves short links. Separate from ruleName so a policy can protect the site without locking the public resolver."
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-component account overrides. Every component always runs as its own account.",
          "properties": {
            "redirect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "maxLength": 253
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "urls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "maxLength": 253
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "web": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "maxLength": 253
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "stat": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "maxLength": 253
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "log": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                  "maxLength": 253
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "description": "The front end's own settings.",
      "properties": {
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["off", "report-only", "enforce"] },
            "connectSrc": {
              "type": "array",
              "items": { "type": "string", "pattern": "^https?://[A-Za-z0-9.*-]+(:[0-9]+)?$" }
            },
            "reportUri": { "type": "string", "pattern": "^[^\\s;,'\"]*$" }
          }
        },
        "faro": {
          "type": "object",
          "additionalProperties": false,
          "description": "Browser telemetry. Public by design: every value is shipped to every visitor, so no secret belongs here.",
          "properties": {
            "enabled": { "type": "boolean" },
            "collectorUrl": { "type": "string", "pattern": "^(https://[^\\s'\"<>;,]+|/[^\\s'\"<>;,?#]*)$" },
            "apiKey": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" },
            "appName": { "type": "string" },
            "environment": { "type": "string" },
            "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "preStopSeconds"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "preStopSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "disruption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Absent follows `availability`: a budget renders for `high` only."
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "off",
            "permissive",
            "strict"
          ],
          "description": "The release-wide default for the components that serve an authenticated boundary. `strict` is accepted here only where `redirect` is overridden below: redirect is gateway-fronted and can never be strict, so the render refuses it when inherited. To make only the URL service strict, set `permissive` (or `off`) here and `tls.components.urls.mode: strict`."
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-component override of tls.mode, for the two components that SERVE an authenticated boundary. `web` and `stat` only call out and have no mode of their own. Unset means tls.mode.",
          "properties": {
            "urls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive",
                    "strict"
                  ]
                }
              }
            },
            "redirect": {
              "type": "object",
              "additionalProperties": false,
              "description": "Never `strict`: the redirect service is fronted by a gateway that terminates TLS and forwards cleartext.",
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive"
                  ]
                }
              }
            }
          }
        },
        "trustDomain": {
          "type": "string"
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "grantRequest": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "peers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redirect": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrate",
        "redirect",
        "urls",
        "stat",
        "log",
        "web",
        "prober"
      ],
      "properties": {
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
