{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener chart values",
  "description": "Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database",
    "events",
    "image",
    "log",
    "replicas",
    "resources",
    "route"
  ],
  "properties": {
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "name",
        "owner",
        "app"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "redirectSubject",
        "requestSubject",
        "stream",
        "consumer"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "redirectSubject": {
          "type": "string",
          "minLength": 1
        },
        "requestSubject": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redirect": {
          "type": "integer",
          "minimum": 0
        },
        "stat": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale.",
      "properties": {
        "redirect": {
          "type": "object"
        },
        "stat": {
          "type": "object"
        },
        "migrate": {
          "type": "object"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
