{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener chart values",
  "description": "Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database",
    "events",
    "image",
    "log",
    "replicas",
    "resources",
    "route",
    "archive"
  ],
  "properties": {
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "name",
        "owner",
        "app"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "redirectSubject",
        "requestSubject",
        "stream",
        "consumers"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "redirectSubject": {
          "type": "string",
          "minLength": 1
        },
        "requestSubject": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "object",
          "additionalProperties": false,
          "description": "One durable name per consuming component, shared by every replica of it.",
          "required": [
            "stat",
            "log"
          ],
          "properties": {
            "stat": {
              "type": "string",
              "minLength": 1
            },
            "log": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the request archive goes. The vendor is not in here: an endpoint, a region and a path-style flag reach a cloud service, a store inside the cluster or a test double.",
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "The bucket, which exists already. Required at install time, not here: an empty default is what makes the refusal name the value rather than the schema."
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "ca": {
              "type": "string"
            },
            "pathStyle": {
              "type": "boolean"
            },
            "credentialsSecret": {
              "type": "string",
              "description": "The Secret holding static credentials. Empty means the SDK's ambient credentials, which is what a workload identity provides."
            },
            "accessKeyIDKey": {
              "type": "string",
              "minLength": 1
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRecords": {
              "type": "integer",
              "minimum": 1
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redirect": {
          "type": "integer",
          "minimum": 0
        },
        "stat": {
          "type": "integer",
          "minimum": 0
        },
        "log": {
          "type": "integer",
          "minimum": 0
        },
        "urls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Passed to Kubernetes verbatim, so the inside of each entry stays open: the platform validates it, and a chart that reimplements that schema goes stale.",
      "properties": {
        "redirect": {
          "type": "object"
        },
        "stat": {
          "type": "object"
        },
        "migrate": {
          "type": "object"
        },
        "log": {
          "type": "object"
        },
        "urls": {
          "type": "object"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        },
        "ruleName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "preStopSeconds"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "preStopSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "disruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "off",
            "permissive",
            "strict"
          ]
        },
        "trustDomain": {
          "type": "string"
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "grantRequest": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "peers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redirect": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "serviceAccount"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
