          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${logsds}"
          },
          "expr": "kubernetes.pod_namespace:\"$namespace\" k8s.cluster.name:\"$cluster\" level:~\"(?i)^(error|err|fatal|critical)$\"",
          "queryType": "instant",
          "refId": "A",
