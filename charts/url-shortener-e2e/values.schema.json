{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener-e2e chart values",
  "description": "Strict everywhere this chart defines something: a typo must fail the render rather than be ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appRelease",
    "mode",
    "database",
    "events",
    "archive",
    "images",
    "job",
    "resources"
  ],
  "properties": {
    "appRelease": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "full",
        "tenant"
      ]
    },
    "rolloutTimeout": {
      "type": "string"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "name",
        "owner",
        "app"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "passwordSecret"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "redirectSubject",
        "requestSubject",
        "statConsumer",
        "logConsumer"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "redirectSubject": {
          "type": "string",
          "minLength": 1
        },
        "requestSubject": {
          "type": "string",
          "minLength": 1
        },
        "statConsumer": {
          "type": "string",
          "minLength": 1
        },
        "logConsumer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "accessKeyIDKey": {
          "type": "string",
          "minLength": 1
        },
        "secretAccessKeyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "tokenExchange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenURL": {
              "type": "string"
            },
            "client": {
              "type": "string"
            },
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "caConfigMap": {
          "type": "string"
        },
        "caConfigMapKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e2e"
      ],
      "properties": {
        "e2e": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "repository"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "prober": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "repository"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        }
      }
    },
    "pullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backoffLimit",
        "activeDeadlineSeconds"
      ],
      "properties": {
        "ttlSecondsAfterFinished": {
          "description": "OPTIONAL, and UNSET by default: a GitOps controller with self-heal on recreates a Job that deleted itself, so templates/job.yaml renders this key only when it is set. Absent or null skip it; a value must still clear the floor below.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 120
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "annotations": {
          "description": "Rendered on the Job's own metadata, never the pod template's \u2014 for a GitOps controller that must replace, not patch, an immutable Job when this chart's values change at the same version, e.g. a force/replace sync option.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "description": "The e2e Job's own switch for presenting a workload identity, on top of the release-wide tls block. Needs tls.mode (or a target's override) not off.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale."
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prober": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "interval",
        "keyPrefix"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "keyPrefix": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "resources": {
          "type": "object",
          "description": "Passed to Kubernetes verbatim, so the inside stays open: the platform validates it, and a chart that reimplements that schema goes stale."
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        },
        "drain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "podSecurity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 0
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 0
            },
            "fsGroup": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "off",
            "permissive",
            "strict"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-target override of tls.mode: the mode the APPLICATION RELEASE runs `urls` and `redirect` in, which decides the port and scheme this chart's callers dial. Same meaning as charts/url-shortener's own tls.components. Unset means tls.mode.",
          "properties": {
            "urls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive",
                    "strict"
                  ]
                }
              }
            },
            "redirect": {
              "type": "object",
              "additionalProperties": false,
              "description": "Never `strict`: the application chart runs redirect behind a gateway that terminates TLS.",
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "permissive"
                  ]
                }
              }
            }
          }
        },
        "trustDomain": {
          "type": "string"
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "grantRequest": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "serviceAccount"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "serviceAccount": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "http/protobuf",
            "grpc"
          ]
        },
        "tracesSampler": {
          "type": "string",
          "minLength": 1
        },
        "sampleRatio": {
          "type": "string",
          "minLength": 1
        },
        "resourceAttributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
