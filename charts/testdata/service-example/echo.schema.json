{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/service-example/schemas/echo.json",
  "title": "echo",
  "description": "A service that answers with a greeting.",
  "allOf": [
    { "$ref": "https://github.com/truvity/policy/schemas/service.json" }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["listen", "greeting"],
  "properties": {
    "listen": { "$ref": "https://github.com/truvity/policy/schemas/fragments/listen.json" },
    "tls": { "$ref": "https://github.com/truvity/policy/schemas/fragments/tls.json" },
    "greeting": { "type": "string", "minLength": 1 },
    "secrets": { "$ref": "https://github.com/truvity/policy/schemas/fragments/secrets.json" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenSecret"],
      "description": "A store the service reads. The token is a SECRET, so the file names it (a name under `secrets`) and the chart projects it as a file with `platform.secretFiles`.",
      "properties": {
        "tokenSecret": { "$ref": "https://github.com/truvity/policy/schemas/fragments/secrets.json#/$defs/name" }
      }
    }
  }
}
