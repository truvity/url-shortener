{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "url-shortener-infra chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postgres",
    "events"
  ],
  "properties": {
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances",
        "storage",
        "database",
        "ownerRole",
        "runtimeRole",
        "runtimePasswordSecret"
      ],
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "runtimeRole": {
          "type": "string",
          "minLength": 1
        },
        "runtimePasswordSecret": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objectStoreName": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            }
          }
        },
        "serverTLS": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "caSecretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "storage",
        "subjects",
        "url"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "enum": [
            "memory",
            "file"
          ]
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxAge": {
          "type": "string"
        }
      }
    }
  }
}
