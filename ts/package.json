{
  "name": "@truvity/policy",
  "version": "0.0.0",
  "description": "Load a service's configuration: read one file, validate it against a schema, decode it, and stop.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truvity/policy.git",
    "directory": "ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.14.1"
}
