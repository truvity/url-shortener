{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    // esModuleInterop without verbatimModuleSyntax, deliberately. Two of the
    // three runtime dependencies are CommonJS packages whose types use
    // `export default`; under verbatim syntax TypeScript resolves that to the
    // module namespace and the import stops being callable, while the runtime
    // import works perfectly. A strictness that makes correct code fail to
    // compile is one that gets worked around with casts, which is worse than
    // not having it.
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
